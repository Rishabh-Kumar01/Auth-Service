# Server Configuration
PORT=8001
NODE_ENV=development

# Database Configuration
DB_SYNC=false

# JWT Configuration
JWT_KEY=your-jwt-secret-key-here
EMAIL_VERIFY_KEY=your-email-verify-secret-key-here

# Email Configuration (Gmail OAuth)
USER=your-email@gmail.com
PASS=your-app-password
SERVICE=gmail
CLIENT_ID=your-google-oauth-client-id
CLIENT_SECRET=your-google-oauth-client-secret
REDIRECT_URI=https://developers.google.com/oauthplayground
REFRESH_TOKEN=your-google-oauth-refresh-token

# Message Queue Configuration (RabbitMQ)
MESSAGE_BROKER_URL=amqp://localhost
REMINDER_BINDING_KEY=user_created
EXCHANGE_NAME=user_exchange

# AWS Cognito Configuration
# Get these values from your AWS Cognito User Pool
AWS_REGION=us-east-1
COGNITO_USER_POOL_ID=your-cognito-user-pool-id
COGNITO_CLIENT_ID=your-cognito-app-client-id
COGNITO_CLIENT_SECRET=your-cognito-app-client-secret

# Cookie Configuration
COOKIE_SECRET=your-cookie-secret-for-signing
COOKIE_MAX_AGE=604800000

# CORS Configuration
CORS_ORIGIN=http://localhost:3000
